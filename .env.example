# Cấu hình MES StoreProcedure API (invoke6 + sCode)
VITE_MES_URL=http://localhost:8080

# invokeN — với MES hiện tại là 6 (`/MES/invoke6?sCode=...`).
VITE_MES_INVOKE=6

# Nhà máy đang xem — dùng cho tham số `factory` (getMfgType, getProductionAreaList).
VITE_DEFAULT_FACTORY=VN

# Log level của app: debug | info | warn | error.
VITE_LOG_LEVEL=debug

# Vite dev server proxy `/MES` sang đích này.
MES_PROXY_TARGET=http://localhost:8080
