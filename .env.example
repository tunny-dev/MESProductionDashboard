# =============================================================================
# Cấu hình MES StoreProcedure API (invoke6 + sCode)
#
# Sao chép thành .env.local rồi sửa để override cục bộ.
# File .env.local KHÔNG được commit.
#
# Quy ước tiền tố:
#   VITE_*       — public, được bundle vào client JS (browser đọc được).
#   Không VITE_  — server-only, Vite không expose ra ngoài.
# =============================================================================

# -----------------------------------------------------------------------------
# Địa chỉ máy MES — browser gọi THẲNG host này.
#   POST {VITE_MES_URL}/MES/invoke{N}?sCode=...
#   POST {VITE_MES_URL}/MES/auth         (đăng nhập lấy Bearer token)
#
# Máy MES phải trả CORS header cho origin của FE (hiện MES đã bật
# `Access-Control-Allow-Origin: *` + cho phép header authorization, content-type).
#
# Để TRỐNG = gọi same-origin (dùng khi đã có reverse proxy như IIS ARR forward
# `/MES` sang máy MES).
# -----------------------------------------------------------------------------
VITE_MES_URL=http://localhost:8080

# invokeN — với MES hiện tại là 6 (`/MES/invoke6?sCode=...`).
VITE_MES_INVOKE=6

# Nhà máy đang xem — dùng cho tham số `factory` (getMfgType, getProductionAreaList).
VITE_DEFAULT_FACTORY=VN

# Log level của app: debug | info | warn | error.
VITE_LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Server-only (không có tiền tố VITE_)
# -----------------------------------------------------------------------------

# LỐI THOÁT HIỂM LÚC DEV — chỉ có tác dụng khi `VITE_MES_URL` để TRỐNG:
# Vite dev server proxy `/MES` sang đích này.
MES_PROXY_TARGET=http://localhost:8080
