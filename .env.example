# =============================================================================
# .env.example — template tham khảo cho file .env
#
# Sao chép thành .env.local rồi điền giá trị thật để override.
# File .env.local KHÔNG được commit (đã có trong .gitignore).
#
# Quy ước tiền tố:
#   VITE_*       — public, được bundle vào client JS (browser đọc được).
#   Không VITE_  — server-only, Vite không expose ra ngoài.
# =============================================================================


# -----------------------------------------------------------------------------
# APP — URL gốc REST API thông thường (không qua MES invoke).
# Để trống nếu dùng Vite proxy hoặc same-origin deployment.
# -----------------------------------------------------------------------------
VITE_API_BASE_URL=


# =============================================================================
# HỆ THỐNG MES BACKEND
#
# Mỗi hệ thống có một cặp URL + invoke number riêng.
# invoke<N> tương ứng với datasource được cấu hình trên server MES.
# Ví dụ: invoke6 → sixthnamedJdbcTemplate / sixth txManager.
# =============================================================================

# SFCS — hệ thống sản xuất chính
VITE_MES_SFCS_URL=http://10.1.200.31
VITE_MES_SFCS_INVOKE=6

# Mã nhà máy gửi trong P_DC003 khi gọi GET_MFG_TYPE (danh mục công đoạn).
# Mặc định 'VN' nếu không đặt.
# VITE_MES_FACTORY=VN

# WIP — hệ thống theo dõi lô hàng (bỏ comment khi dùng)
# VITE_MES_WIP_URL=http://10.1.200.200
# VITE_MES_WIP_INVOKE=6

# ERP — hoạch định nguồn lực (bỏ comment khi dùng)
# VITE_MES_ERP_URL=http://10.1.200.50
# VITE_MES_ERP_INVOKE=3


# =============================================================================
# LOGGING
#
# Level tối thiểu cho logger: debug | info | warn | error | silent
# Gợi ý: debug khi dev, warn khi production.
# =============================================================================
VITE_LOG_LEVEL=debug


# =============================================================================
# XÁC THỰC MES  (server-only — KHÔNG có tiền tố VITE_)
#
# Khi deploy IIS : proxy do web.config (ARR) xử lý, các biến này không cần.
# Khi chạy dev   : Vite middleware đọc các biến này để forward /api/mes/auth.
# =============================================================================

# URL proxy xác thực MES — Vite dev middleware forward login request tới đây.
MES_AUTH_URL=http://10.1.200.31/MES/auth
